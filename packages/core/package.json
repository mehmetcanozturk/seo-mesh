{
  "name": "@seomesh/core",
  "version": "0.1.2",
  "description": "Framework-agnostic JSX tree traversal and JSON-LD builder for seo-mesh",
  "license": "MIT",
  "author": "Mehmet Can Öztürk",
  "homepage": "https://github.com/mehmetcanozturk/seo-mesh#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/mehmetcanozturk/seo-mesh.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/mehmetcanozturk/seo-mesh/issues"
  },
  "keywords": [
    "seo", "json-ld", "structured-data", "schema-org", "react", "nextjs",
    "seo-mesh", "rich-results", "google", "metadata"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist coverage"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "rimraf": "^5.0.0",
    "tsup": "^8.1.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}


