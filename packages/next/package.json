{
  "name": "@seomesh/next",
  "version": "0.1.3",
  "description": "Next.js App Router integration � sitemap, robots.txt, llms.txt, SEO audit and all seo-mesh components",
  "license": "MIT",
  "author": "Mehmet Can Öztürk",
  "homepage": "https://github.com/mehmetcanozturk/seo-mesh#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/mehmetcanozturk/seo-mesh.git",
    "directory": "packages/next"
  },
  "bugs": {
    "url": "https://github.com/mehmetcanozturk/seo-mesh/issues"
  },
  "keywords": [
    "seo", "nextjs", "next", "app-router", "json-ld", "structured-data",
    "sitemap", "robots-txt", "llms-txt", "schema-org", "seo-mesh",
    "rich-results", "open-graph", "ai-bots"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@seomesh/core": "workspace:*",
    "@seomesh/react": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@seomesh/core": "workspace:*",
    "@seomesh/react": "workspace:*",
    "@types/react": "^19.0.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^5.0.0",
    "tsup": "^8.1.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}



