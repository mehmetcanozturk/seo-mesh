{
  "name": "seo-mesh",
  "private": true,
  "version": "0.0.0",
  "description": "Component-first structured metadata engine for modern frontend frameworks",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch --parallel",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yaml}\" --ignore-path .prettierignore",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "rimraf": "^5.0.0",
    "turbo": "^2.1.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
